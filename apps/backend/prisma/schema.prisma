generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  characters           Character[]
  notifications        Notification[]
  questCategories      QuestCategory[]
  pushSubscriptions    PushSubscription[]
  notificationPreference NotificationPreference?

  @@map("users")
}

// ─── Character ───────────────────────────────────────────────────────────────

model Character {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String
  avatar       String?
  level        Int      @default(1)
  experience   Int      @default(0)
  powerScore   Int      @default(5) @map("power_score")
  class        String
  title        String
  strength     Int      @default(1)
  intelligence Int      @default(1)
  agility      Int      @default(1)
  vitality     Int      @default(1)
  luck         Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  progression Progression?
  rewards     Reward[]
  history     CharacterHistory[]
  quests      Quest[]
  restPoints  CharacterRestPoint[]

  @@map("characters")
}

// ─── Character Rest Points───────────────────────────────────────────────────────────────

model CharacterRestPoint {
  id          String   @id @default(uuid())
  characterId String   @unique @map("character_id")
  restPoints  Int      @default(0) @map("rest_points")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("characters_rest_points")
}

model CharacterHistory {
  id          String   @id @default(uuid())
  characterId String   @map("character_id")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("character_history")
}

// ─── Quest Category ──────────────────────────────────────────────────────────

model QuestCategory {
  id        String   @id @default(uuid())
  name      String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User    @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  quests  Quest[]

  @@map("quest_categories")
}

// ─── Quest (Template + Instance) ─────────────────────────────────────────────

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  CUSTOM
}

enum QuestInstanceStatus {
  PENDING
  STARTED
  COMPLETED
  FAILED
  EXPIRED
}

// A Quest is a TEMPLATE — the recurring definition. It never represents an execution.
model Quest {
  id          String     @id @default(uuid())
  characterId String     @map("character_id")
  categoryId  String?    @map("category_id")
  title       String
  description String
  recurrence  Recurrence @default(NONE)
  rank        String
  rewardXp    Int        @default(0) @map("reward_xp")
  active      Boolean    @default(true)
  // Last day (UTC calendar day) for a NONE-recurrence quest's single instance — the actual
  // deadline is always 23:59:59.999 UTC of that day. Ignored for recurring types, which
  // derive their deadline from the period. Always set (defaults to "tomorrow" at creation
  // when the client omits it) — a Quest is never left without a deadline.
  deadlineDate DateTime   @map("deadline_date")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  character          Character                @relation(fields: [characterId], references: [id], onDelete: Cascade)
  category           QuestCategory?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  objectiveTemplates QuestObjectiveTemplate[]
  instances          QuestInstance[]

  @@index([characterId])
  @@map("quests")
}

// Blueprint of objectives, copied into each QuestInstance on materialisation.
model QuestObjectiveTemplate {
  id          String @id @default(uuid())
  questId     String @map("quest_id")
  description String
  target      Int

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([questId])
  @@map("quest_objective_templates")
}

// A QuestInstance is one EXECUTION of a template for a given period.
model QuestInstance {
  id            String              @id @default(uuid())
  questId       String              @map("quest_id")
  scheduledDate DateTime            @map("scheduled_date")
  deadline      DateTime
  startedAt     DateTime?           @map("started_at")
  completedAt   DateTime?           @map("completed_at")
  progress      Int                 @default(0)
  status        QuestInstanceStatus @default(PENDING)
  rewardGranted Boolean             @default(false) @map("reward_granted")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  quest      Quest                    @relation(fields: [questId], references: [id], onDelete: Cascade)
  objectives QuestInstanceObjective[]

  @@unique([questId, scheduledDate])
  @@index([status])
  @@map("quest_instances")
}

model QuestInstanceObjective {
  id              String  @id @default(uuid())
  questInstanceId String  @map("quest_instance_id")
  description     String
  target          Int
  current         Int     @default(0)
  completed       Boolean @default(false)

  instance QuestInstance @relation(fields: [questInstanceId], references: [id], onDelete: Cascade)

  @@index([questInstanceId])
  @@map("quest_instance_objectives")
}

// ─── Progression ─────────────────────────────────────────────────────────────

model Progression {
  id              String   @id @default(uuid())
  characterId     String   @unique @map("character_id")
  level           Int      @default(1)
  experience      Int      @default(0)
  totalExperience Int      @default(0) @map("total_experience")
  updatedAt       DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("progressions")
}

// ─── Reward ──────────────────────────────────────────────────────────────────

model Reward {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  type        String
  status      String    @default("pending")
  amount      Int?
  itemId      String?   @map("item_id")
  source      String
  expiresAt   DateTime? @map("expires_at")
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@map("rewards")
}

// ─── Event Store ──────────────────────────────────────────────────────────────

model Event {
  id           Int      @id @default(autoincrement())
  eventName    String   @map("event_name")
  eventPayload Json     @map("event_payload")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("events")
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  channel   String   @default("in_app")
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// One browser/device subscription for the Web Push API (endpoint + the two keys the browser
// generates). A user can have several — one per device/browser they enabled push on.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// One row per user — which notification types/channels they want. Mirrors
// domains/notification/domain/notification.ts#NotificationPreferences exactly.
model NotificationPreference {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  pushEnabled    Boolean  @default(true) @map("push_enabled")
  emailEnabled   Boolean  @default(false) @map("email_enabled")
  whatsappEnabled Boolean @default(false) @map("whatsapp_enabled")
  questReminder  Boolean  @default(true) @map("quest_reminder")
  questExpired   Boolean  @default(true) @map("quest_expired")
  levelUp        Boolean  @default(true) @map("level_up")
  rankUp         Boolean  @default(true) @map("rank_up")
  penalty        Boolean  @default(true) @map("penalty")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
