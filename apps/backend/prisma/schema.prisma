generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity ───────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  characters      Character[]
  notifications   Notification[]
  questCategories QuestCategory[]

  @@map("users")
}

// ─── Character ───────────────────────────────────────────────────────────────

model Character {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String
  avatar       String?
  level        Int      @default(1)
  experience   Int      @default(0)
  powerScore   Int      @default(5) @map("power_score")
  class        String
  title        String
  strength     Int      @default(1)
  intelligence Int      @default(1)
  agility      Int      @default(1)
  vitality     Int      @default(1)
  luck         Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id])
  progression Progression?
  rewards     Reward[]
  history     CharacterHistory[]
  quests      Quest[]
  restPoints  CharacterRestPoint[]

  @@map("characters")
}

// ─── Character Rest Points───────────────────────────────────────────────────────────────

model CharacterRestPoint {
  id          String   @id @default(uuid())
  characterId String   @unique @map("character_id")
  restPoints  Int      @default(0) @map("rest_points")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id])

  @@map("characters_rest_points")
}

model CharacterHistory {
  id          String   @id @default(uuid())
  characterId String   @map("character_id")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id])

  @@map("character_history")
}

// ─── Quest Category ──────────────────────────────────────────────────────────

model QuestCategory {
  id        String   @id @default(uuid())
  name      String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  creator User    @relation(fields: [createdBy], references: [id])
  quests  Quest[]

  @@map("quest_categories")
}

// ─── Quest ───────────────────────────────────────────────────────────────────

model Quest {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  categoryId  String?   @map("category_id")
  title       String
  description String
  questRank   String    @map("quest_rank")
  type        String
  status      String    @default("available")
  rewardXp    Int       @default(0) @map("reward_xp")
  rewardGold  Int       @default(0) @map("reward_gold")
  minLevel    Int       @default(1) @map("min_level")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  character  Character        @relation(fields: [characterId], references: [id])
  category   QuestCategory?   @relation(fields: [categoryId], references: [id])
  objectives QuestObjective[]

  @@map("quests")
}

model QuestObjective {
  id          String  @id @default(uuid())
  questId     String  @map("quest_id")
  description String
  target      Int
  current     Int     @default(0)
  completed   Boolean @default(false)

  quest Quest @relation(fields: [questId], references: [id])

  @@map("quest_objectives")
}

// ─── Progression ─────────────────────────────────────────────────────────────

model Progression {
  id              String   @id @default(uuid())
  characterId     String   @unique @map("character_id")
  level           Int      @default(1)
  experience      Int      @default(0)
  totalExperience Int      @default(0) @map("total_experience")
  updatedAt       DateTime @updatedAt @map("updated_at")

  character Character @relation(fields: [characterId], references: [id])

  @@map("progressions")
}

// ─── Reward ──────────────────────────────────────────────────────────────────

model Reward {
  id          String    @id @default(uuid())
  characterId String    @map("character_id")
  type        String
  status      String    @default("pending")
  amount      Int?
  itemId      String?   @map("item_id")
  source      String
  expiresAt   DateTime? @map("expires_at")
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id])

  @@map("rewards")
}

// ─── Event Store ──────────────────────────────────────────────────────────────

model Event {
  id           Int      @id @default(autoincrement())
  eventName    String   @map("event_name")
  eventPayload Json     @map("event_payload")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("events")
}

// ─── Notification ────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  channel   String   @default("in_app")
  title     String
  message   String
  read      Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
