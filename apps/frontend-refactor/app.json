{
  "expo": {
    "name": "Solo Leveling System",
    "slug": "solo-leveling-refactor",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sololeveling",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1720",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1720",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1720",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set your Hunter's avatar.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take a photo for your Hunter's avatar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}